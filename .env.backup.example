# Copie para .env.backup.local. Nunca envie credenciais ao GitHub.
BACKUP_SUPABASE_URL=https://SEU-PROJETO.supabase.co
BACKUP_SERVICE_ROLE_KEY=CHAVE_PRIVADA_SERVICE_ROLE
# Connection string do Session Pooler (porta 5432), com senha codificada para URL.
BACKUP_DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@SEU-HOST:5432/postgres
# Opcional: caminho absoluto para supabase.exe se não estiver no PATH.
# BACKUP_SUPABASE_CLI=C:\Ferramentas\supabase.exe
