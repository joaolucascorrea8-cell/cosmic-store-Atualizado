# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Compatibilidade com projetos antigos. Use apenas uma chave secreta no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Pix
PIX_KEY=
PIX_RECEIVER_NAME=
PIX_RECEIVER_CITY=

# E-mail (Gmail da Cosmic Store)
# Use a Senha de app do Google, nunca a senha normal da conta.
GMAIL_USER=cosmicstoreteam@gmail.com
GMAIL_APP_PASSWORD=
# Opcional. Se vazio, usa "Cosmic Store".
GMAIL_FROM_NAME=Cosmic Store
# E-mail que recebe alertas administrativos por e-mail, se você quiser manter esse canal.
ADMIN_NOTIFICATION_EMAIL=

# Discord
NEXT_PUBLIC_DISCORD_INVITE_URL=https://discord.gg/qQkQzKng3
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_WEBHOOK_URL=
DISCORD_ADMIN_MENTION=

# Limpeza automática de imagens antigas de pedidos/suporte
# Gere um valor longo/aleatório e configure a mesma variável na Vercel.
CRON_SECRET=
# Opcional. Se não informar, o sistema usa 60 dias.
CHAT_ATTACHMENT_RETENTION_DAYS=30
